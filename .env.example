# ─────────────────────────────────────────────────────────────────────────────
# Re-EL Mailer — environment variables
#
# Copy to `.env` for local development (`vercel dev` reads it automatically).
# NEVER commit a real .env file. These values live only in Vercel environment
# variables for production.
#
# NOTHING in this file belongs in apps/web/**. Everything below is server-side.
# See docs/security.md §"Secret leakage".
# ─────────────────────────────────────────────────────────────────────────────

# ── Public app metadata ─────────────────────────────────────────────────────
# Where the frontend is served from. Used for CORS allowlisting and for links
# inside outbound email (password reset, etc). Comma-separate for multiple.
APP_URL=https://mail.re-el.co.za
ALLOWED_ORIGINS=https://mail.re-el.co.za,https://www.re-el.co.za,https://re-el.co.za

# ── Supabase (PostgreSQL + Storage) ─────────────────────────────────────────
# Supabase Project Settings → Database → Connection string → URI (use the
# "Session pooler"/IPv4-safe form if your network is IPv4-only).
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# For migrations prefer the direct connection:
# DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Supabase project URL and service-role key (Project Settings → API).
# The service-role key bypasses RLS: it is server-only and must never be
# shipped to a browser. It is used only for signed URLs on the
# `mail-attachments` bucket.
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# TLS: `true` for managed Supabase (required), `false` only for local Postgres.
DATABASE_SSL=true
# Refuse connections that are not TLS even when SSL is enabled.
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# ── Authentication ──────────────────────────────────────────────────────────
# openssl rand -hex 48   → signs session access tokens
JWT_SECRET=
# openssl rand -hex 48   → derives password-reset / email-verify tokens
SESSION_SECRET=
# Peppers the stored refresh/reset token hashes. Rotating it invalidates every
# live session and every outstanding reset link.
TOKEN_PEPPER=
# Access token lifetime (short-lived, per the security model in docs/security.md)
ACCESS_TOKEN_TTL=15m
# Refresh token lifetime (sent as an httpOnly cookie)
REFRESH_TOKEN_TTL_DAYS=30
# How long a password-reset link stays valid
PASSWORD_RESET_TTL_MINUTES=60
# bcrypt cost factor. Raising it upgrades stored hashes at the next login.
# Argon2id would be stronger but needs a native module, which breaks serverless
# builds; see docs/security.md.
BCRYPT_ROUNDS=12
# Set to `true` when serving over HTTPS (required in production)
COOKIE_SECURE=true
# Set to `true` only if the frontend and API are on *different sites* (not just
# different subdomains). mail.re-el.co.za + api.mail.re-el.co.za is same-site,
# so this should stay `false`.
COOKIE_SAMESITE=lax

# ── Resend (outbound email + inbound webhooks) ──────────────────────────────
RESEND_API_KEY=re_
# The verified sending identity. Must match a domain verified in Resend.
MAIL_FROM_EMAIL=akani@re-el.co.za
MAIL_FROM_NAME=Re-EL Mailer
MAIL_REPLY_TO=
# Optional: dedicated subdomain for bounces / abuse reports
MAIL_BOUNCE_ADDRESS=bounces@re-el.co.za
# Domain(s) this deployment serves mailboxes for (comma separated).
MAIL_DOMAINS=re-el.co.za

# Inbound / event webhooks are signed with these svix-style secrets from
# Resend → Webhooks. Without them the webhook endpoint returns 401.
RESEND_INBOUND_WEBHOOK_SECRET=
RESEND_EVENT_WEBHOOK_SECRET=
# Optional shared secret for /api/health?action=ping (monitoring uptime).
HEALTHCHECK_TOKEN=

# ── Storage ─────────────────────────────────────────────────────────────────
# Supabase Storage bucket for attachments (created by database/schema.sql).
ATTACHMENT_BUCKET=mail-attachments
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_BUCKET_PUBLIC=false

# ── Database limits ─────────────────────────────────────────────────────────
# A serverless instance gets one pool; keep this small so the whole fleet cannot
# exhaust Supabase's connection budget. Raise only if the plan allows it.
DATABASE_POOL_MAX=5
DATABASE_STATEMENT_TIMEOUT_MS=8000
DATABASE_CONNECTION_TIMEOUT_MS=8000
DATABASE_IDLE_TIMEOUT_MS=10000
# Rejects an oversized JSON body before it is parsed.
MAX_BODY_BYTES=1048576

# ── Sending limits (application-level abuse controls) ───────────────────────
# NOTE: these are Re-EL Mailer's own limits. They sit on top of (never replace)
# Resend's account limits and recipient/domain reputation rules.
SEND_DAILY_LIMIT_USER=100
SEND_HOURLY_LIMIT_USER=25
SEND_DAILY_LIMIT_ADMIN=1000
SEND_HOURLY_LIMIT_ADMIN=250
SEND_DAILY_LIMIT_DOMAIN=5000
SEND_MAX_RECIPIENTS=25
SEND_MAX_RECIPIENTS_BCC=50
SEND_MAX_SUBJECT_LENGTH=200
SEND_MAX_BODY_BYTES=512000
# Pause between provider calls to stay clear of Resend's burst protection
RESEND_REQUEST_DELAY_MS=0

# ── Rate limiting (fixed-window counters in Postgres) ───────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_MAX_AUTH_ATTEMPTS=10
RATE_LIMIT_MAX_SEND=30
RATE_LIMIT_MAX_SEARCH=90

# ── Inbound processing ──────────────────────────────────────────────────────
# Persist the full raw MIME for inbound messages (larger rows, useful for
# forensics). Attachments always go to Storage regardless of this flag.
STORE_RAW_MIME=false
# Reject inbound mail above this size (bytes) before parsing.
INBOUND_MAX_BYTES=26214400
# Automatically mark inbound messages as read when they come from an
# allow-listed address.
INBOUND_AUTO_READ_SENDERS=

# ── Scheduled maintenance ───────────────────────────────────────────────────
# Bearer secret for the Vercel Cron retention job. Vercel sends this as
# `Authorization: Bearer <CRON_SECRET>` on every scheduled request, and
# /api/health?action=maintenance rejects the call without it.
# Generate with: openssl rand -base64 48
CRON_SECRET=

# ── Observability ───────────────────────────────────────────────────────────
LOG_LEVEL=info
NODE_ENV=development